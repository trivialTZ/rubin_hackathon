# Copy to .env and fill in your tokens.
# .env is git-ignored — never commit it.

# --- TNS (Transient Name Server) ---
# Required for: scripts/crossmatch_tns.py
# Get your API key + marker info at https://www.wis-tns.org/user
# marker_type is "user" for personal accounts, "bot" for registered bots
TNS_API_KEY=
TNS_TNS_ID=
TNS_MARKER_NAME=
TNS_MARKER_TYPE=user

# --- Lasair ---
# Optional: enables live Lasair Sherlock queries
# ZTF instance: get token at https://lasair-ztf.lsst.ac.uk/profile/
# LSST/DP0 instance: get token at https://lasair.lsst.ac.uk/profile/
LASAIR_TOKEN=
# Set to override the default ZTF endpoint (e.g. for LSST DP0):
# LASAIR_ENDPOINT=https://lasair.lsst.ac.uk

# --- Phase 2 (not yet active) ---
ANTARES_API_KEY=
GOOGLE_CLOUD_PROJECT=

# --- Babamul (Caltech/UMN, BOOM backend; live 2026) ---
# Required for: scripts/_exp_babamul_probe.py and src/debass_meta/access/babamul.py (TBD)
# Sign up at https://babamul.caltech.edu/signup — issues all four values.
# Kafka transport: SASL_PLAINTEXT + SCRAM-SHA-512 (NOT SASL_SSL — port 9093 is misleading).
# REST base URL is derived from BABAMUL_ENV (production → https://babamul.caltech.edu/api/babamul).
BABAMUL_KAFKA_SERVER=kaboom.caltech.edu:9093
BABAMUL_KAFKA_USERNAME=
BABAMUL_KAFKA_PASSWORD=
BABAMUL_API_TOKEN=
BABAMUL_ENV=production
